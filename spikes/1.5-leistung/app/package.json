{
  "name": "openairside-spike-1-5",
  "private": true,
  "version": "0.0.0",
  "description": "Spike 1.5: performance proof on the target systems (five-floor reference scenario, highest game speed, long run) with playfield and panel from spikes 1.3/1.4",
  "license": "MIT",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "build:panel": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never"
  },
  "dependencies": {
    "pixi.js": "8.20.1"
  },
  "devDependencies": {
    "@tanstack/react-table": "9.2.8",
    "electron": "44.7.0",
    "electron-builder": "26.16.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "org.openairside.spike-1-5",
    "productName": "OpenAirside Spike 1.5",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "package.json",
      "main.mjs",
      "preload.cjs",
      "simhost.mjs",
      "renderer/index.html",
      "renderer/main.js",
      "renderer/dist/*.js",
      "native/*.node"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.simulation-games"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game"
    },
    "publish": []
  }
}
